# Provided by configure: the module's source dir + the build top.
# defs.mak sees `srcdir` already set and skips its own srcdir derivation.
srcdir    = @srcdir@
VPATH     = @srcdir@
MAGICDIR  = @top_builddir@
MKDIR	   = $(MAGICSRC)/scripts/mkdirs
OBJS_DIR   = objs
CIFIN	   = $(OBJS_DIR)/CIFin
CIFOUT     = $(OBJS_DIR)/CIFout
IBMCIFIN   = $(OBJS_DIR)/IBMCIFin
IBMCIFOUT  = $(OBJS_DIR)/IBMCIFout
TMCIFIN    = $(OBJS_DIR)/TMCIFin
TMCIFOUT   = $(OBJS_DIR)/TMCIFout
SUBCIFIN   = $(OBJS_DIR)/SUBCIFin
SUBCIFOUT  = $(OBJS_DIR)/SUBCIFout

SED_CMD    = sed -e "s/\\\\/\\\\\\\\/" -e "/^\#/D" -e "s/(gen )/(gen)/" -e "s/(nowell )/(nowell)/" -e "s/(nwell )/(nwell)/" -e "s/(pwell )/(pwell)/"

include ${MAGICDIR}/defs.mak

SC_CPP	   = ${CPP} -I$(srcdir)

# The CIF template objs are built atomically and idempotently: each rule writes
# a temp ($@.new) and replaces the target only if the content changed
# (move-if-change), instead of `rm -f X; ... > X` which left X missing/partial
# to other make threads and rewrote it every build (bumping mtime, so scmos's
# tech files -- which depend on these objs -- needlessly rebuilt each time).
all: $(OBJS_DIR) $(CIFIN) $(CIFOUT) $(IBMCIFIN) $(IBMCIFOUT) $(TMCIFIN) \
	$(TMCIFOUT) $(SUBCIFIN) $(SUBCIFOUT)

clean:;
	rm -rf $(OBJS_DIR)

scg: cifout.c cifout-cmos26b.gen cifout.gen cifout.nw\
	   cifout.others cifout.pw cifout.scgnw cifout.scgpw
	$(SC_CPP) $(srcdir)/scgcifout.c | ${SED_CMD} > $(CIFOUT).new && \
	if cmp -s $(CIFOUT).new $(CIFOUT) 2>/dev/null; then rm -f $(CIFOUT).new; else mv -f $(CIFOUT).new $(CIFOUT); fi

$(OBJS_DIR):
	$(MKDIR) $(OBJS_DIR)

$(CIFIN): $(OBJS_DIR) cifin.c cifin-cmos26b.gen cifin.gen cifin.nw cifin.oldnw\
	  cifin.others cifin.pw cifin-ami16.gen
	$(SC_CPP) -DSTANDARD $(srcdir)/cifin.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(CIFOUT): $(OBJS_DIR) cifout.c cifout-cmos26b.gen cifout.gen cifout.nw\
	   cifout.others cifout.pw cifout-ami16.gen
	$(SC_CPP) -DSTANDARD $(srcdir)/cifout.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(IBMCIFIN): $(OBJS_DIR) cifin.c cifin-ibm.gen
	$(SC_CPP) -DIBM $(srcdir)/cifin.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(IBMCIFOUT): $(OBJS_DIR) cifout.c cifout-ibm.gen
	$(SC_CPP) -DIBM $(srcdir)/cifout.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(TMCIFIN): $(OBJS_DIR) cifin.c cifin-cmos26b.gen
	$(SC_CPP) -DTIGHTMETAL $(srcdir)/cifin.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(TMCIFOUT): $(OBJS_DIR) cifout.c cifout-cmos26b.gen
	$(SC_CPP) -DTIGHTMETAL $(srcdir)/cifout.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(SUBCIFIN): $(OBJS_DIR) cifin.c cifin-cmos26g.gen cifin-cmos14b.gen
	$(SC_CPP) -DSUBMICRON $(srcdir)/cifin.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi

$(SUBCIFOUT): $(OBJS_DIR) cifout.c cifout-cmos26g.gen cifout-cmos14b.gen
	$(SC_CPP) -DSUBMICRON $(srcdir)/cifout.c | ${SED_CMD} > $@.new && \
	if cmp -s $@.new $@ 2>/dev/null; then rm -f $@.new; else mv -f $@.new $@; fi
